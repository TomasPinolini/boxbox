# Server
PORT=3000
NODE_ENV=development

# Database — set your PostgreSQL connection string
DATABASE_URL=

# Auth — generar con: openssl rand -base64 48
# Mínimo 32 chars (256 bits de entropía, requerimiento de HS256). El server no arranca si son más cortos.
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# Seed — solo para `npx prisma db seed`, no las lee la app
# SEED_ADMIN_PASSWORD: password del admin@boxbox.test que crea el seed. Si no se setea, usa
#   el default de desarrollo 'admin1234', que esta publicado en el repo. Con
#   NODE_ENV=production es OBLIGATORIA y el seed aborta si falta.
SEED_ADMIN_PASSWORD=
# SEED_SKIP_RESULTS=1: carga grilla y calendario sin ningun resultado, campeonato en cero.
SEED_SKIP_RESULTS=
