{
  "mcpServers": {
    "prisma": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "cd backend && npx prisma mcp"
      ],
      "env": {}
    },
    "render": {
      "type": "http",
      "url": "https://mcp.render.com/mcp",
      "headers": {
        "Authorization": "Bearer ${RENDER_API_KEY}"
      }
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=inmbedbcedksbjypsjlm&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
    }
  }
}