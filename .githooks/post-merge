#!/bin/sh
# Avisa cuando un pull trajo cambios que dejan tu base de datos vieja.
#
# El caso que lo motivó (2026-10-15): el PR #80 agregó los logos de 3 escuderías y cambió
# `teamLogos` en seed.ts. Al traerlo, el código quedó al día y la DB no. La única señal fue
# un cuadradito de color en /standings, un síntoma que no apunta a su causa. CLAUDE.md
# documenta `db seed` con cuatro disparadores distintos; "el pull tocó el seed" no era uno.
#
# AVISA, no corre nada. Re-seedear es rápido pero escribe en tu base, y un hook que te
# cambia datos sin pedirte permiso es peor que el problema que resuelve.
#
# Siempre sale con 0: un hook roto no tiene por qué ensuciarte un pull que salió bien.

# ORIG_HEAD es donde estabas antes del pull. Lo setean tanto merge como rebase, así que el
# mismo diff sirve para los dos caminos (ver .githooks/post-rewrite).
prev=$(git rev-parse --quiet --verify ORIG_HEAD) || exit 0
[ -n "$prev" ] || exit 0

changed=$(git diff --name-only "$prev" HEAD -- backend/prisma/ 2>/dev/null) || exit 0
[ -n "$changed" ] || exit 0

migraciones=$(printf '%s\n' "$changed" | grep '^backend/prisma/migrations/' || true)
semilla=$(printf '%s\n' "$changed" | grep -E '^backend/prisma/(seed\.ts|seed-data/)' || true)

[ -z "$migraciones" ] && [ -z "$semilla" ] && exit 0

echo
echo "┌───────────────────────────────────────────────────────────────┐"
echo "│  Este pull dejó tu base de datos vieja                        │"
echo "└───────────────────────────────────────────────────────────────┘"

if [ -n "$migraciones" ]; then
  echo
  echo "  Cambiaron las migraciones. Para aplicarlas:"
  echo
  echo "      cd backend && npm run db:migrate"
fi

if [ -n "$semilla" ]; then
  echo
  echo "  Cambió el seed. Tu código conoce datos que tu DB todavía no:"
  echo
  echo "      cd backend && npx prisma db seed"
  echo
  echo "  Es idempotente — correrlo de más no rompe nada."
fi

echo
printf '%s\n' "$changed" | sed 's/^/      /'
echo

exit 0
