{
  "mcpServers": {
    "prisma": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "cd backend && npx prisma mcp"
      ],
      "env": {}
    },
    "render": {
      "type": "http",
      "url": "https://mcp.render.com/mcp",
      "headers": {
        "Authorization": "Bearer ${RENDER_API_KEY}"
      }
    }
  }
}
